@model BookMvc.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h2>🗑️ Delete Book</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this book?</h4>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.Author</dd>

            <dt class="col-sm-3">Genre</dt>
            <dd class="col-sm-9">@Model.Genre</dd>

            <dt class="col-sm-3">Published Year</dt>
            <dd class="col-sm-9">@Model.PublishedYear</dd>

            <dt class="col-sm-3">Rating</dt>
            <dd class="col-sm-9">⭐ @Model.Rating/5</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsRead)
                {
                    <span class="badge bg-success">✅ Read</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">📖 Unread</span>
                }
            </dd>

            <dt class="col-sm-3">Added Date</dt>
            <dd class="col-sm-9">@Model.AddedDate.ToString("MMMM dd, yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="mt-3">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>